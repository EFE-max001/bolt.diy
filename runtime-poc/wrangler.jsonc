{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bolt-workspace-runtime-poc",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "WorkspaceRuntime",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile",
          "build_context": "."
        }
      },
      "observability": {
        "enabled": true
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE_RUNTIME",
        "class_name": "WorkspaceRuntime"
      }
    ]
  },
  "exports": {
    "WorkspaceRuntime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
